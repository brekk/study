import Fn from "Function"
import IO from "IO"
import Process from "Process"
import String from "String"
import { Error } from "Test"
import Wish from "Wish"

import Study from "@/Study"



// runAndPrint :: (String -> a -> a) -> String -> List String -> Wish TestResult TestResult
runAndPrint = (printer, executable, args) => pipe(
  Process.exec(executable, args),
  printer(String.unwords([executable, ...args])),
)(Process.DEFAULT_COMMAND_OPTIONS)
// for testing executables
export technicalWork = (consultant, printer, prep, postCost, executable, name, data) => pipe(
  prep,
  consultant(
    chain(
      pipe(
        runAndPrint(printer, executable),
        postCost,
      ),
    ),
    name,
  ),
)(data)
export technicalReport = technicalWork(Study.asyncReport)
export technicalFailureReport = technicalWork(Study.asyncFail)
_logStep = pipe(
  mappend("running: "),
  IO.pTrace,
)
export chiefExecutiveReport = technicalReport(_logStep)
export chiefExecutiveFailureReport = technicalFailureReport(_logStep)
_yeahGood = (#[as, bs]) => #[Wish.good(as), bs]
export executiveReport = chiefExecutiveReport(map(_yeahGood))
export executiveFailureReport = chiefExecutiveFailureReport(map(_yeahGood))
export _handleStdErr = Wish.mapRej(
  pipe(
    .stderr,
    Error,
  ),
)
// got 'em!
export powerpoint = executiveReport(
  pipe(
    map(.stdout),
    _handleStdErr,
  ),
)
export riskReport = executiveFailureReport(
  pipe(
    map(.stdout),
    map(Fn.always({})),
  ),
)
